(define random-seed! ())
(define random ())
(define random-integer ())
(let ((state 1))
  (define (next-random)
    (set! state (modulo (* state 48271) 2147483647))
    (- state 1))
  (set! random-seed!
    (lambda (seed)
      (if (and (number? seed) (= (modulo seed 1) 0)
               (>= seed 1) (<= seed 2147483646))
          (set! state seed)
          (error "random-seed! expects an integer from 1 through 2147483646"))))
  (set! random (lambda () (/ (next-random) 2147483646)))
  (set! random-integer
    (lambda (bound)
      (if (and (number? bound) (= (modulo bound 1) 0)
               (>= bound 1) (<= bound 2147483646))
          (let ((limit (- 2147483646 (modulo 2147483646 bound))))
            (let retry ((value (next-random)))
              (if (< value limit) (modulo value bound) (retry (next-random)))))
          (error "random-integer expects an integer from 1 through 2147483646")))))

(define (http-get url) (http-request "GET" url '() ""))
(define (http-head url) (http-request "HEAD" url '() ""))
(define (http-delete url) (http-request "DELETE" url '() ""))
(define (http-options url) (http-request "OPTIONS" url '() ""))
(define (http-post url body) (http-request "POST" url '() body))
(define (http-put url body) (http-request "PUT" url '() body))
(define (http-patch url body) (http-request "PATCH" url '() body))
(define (http-status response) (car (cdr response)))
(define (http-headers response) (car (cdr (cdr response))))
(define (http-body response) (car (cdr (cdr (cdr response)))))

(define (node-tag node) (car (cdr node)))
(define (node-attributes node) (car (cdr (cdr node))))
(define (node-children node) (cdr (cdr (cdr node))))
(define (node-with-children node children)
  (append (list 'element (node-tag node) (node-attributes node)) children))
(define (node-attribute node name)
  (let find ((attributes (node-attributes node)))
    (if (null? attributes)
        (error "Attribute not found" name)
        (if (equal? (car (car attributes)) name)
            (car (cdr (car attributes)))
            (find (cdr attributes))))))
(define (node-with-attribute node name value)
  (if (and (string? name) (string? value))
      (let ((others (filter (lambda (attribute) (not (equal? (car attribute) name)))
                           (node-attributes node))))
        (append (list 'element (node-tag node)
                      (cons (list name value) others))
                (node-children node)))
      (error "Attribute name and value must be strings")))
(define (node-text node)
  (if (string? node)
      node
      (if (and (list? node) (not (null? node)))
          (cond ((eq? (car node) 'element)
                 (apply string-append (map node-text (node-children node))))
                ((eq? (car node) 'document)
                 (apply string-append (map node-text (cdr node))))
                ((or (eq? (car node) 'comment) (eq? (car node) 'instruction)
                     (eq? (car node) 'doctype)) "")
                (else (error "Expected a markup node")))
          (error "Expected a markup node"))))
(define (node-find node tag)
  (define (join lists)
    (let loop ((remaining lists) (result '()))
      (if (null? remaining) result
          (loop (cdr remaining) (append result (car remaining))))))
  (if (string? tag)
      (if (string? node)
          '()
          (cond ((eq? (car node) 'element)
                 (append (if (equal? (node-tag node) tag) (list node) '())
                         (join (map (lambda (child) (node-find child tag))
                                    (node-children node)))))
                ((eq? (car node) 'document)
                 (join (map (lambda (child) (node-find child tag)) (cdr node))))
                ((or (eq? (car node) 'comment) (eq? (car node) 'instruction)
                     (eq? (car node) 'doctype)) '())
                (else (error "Expected a markup node"))))
      (error "Node tag must be a string")))
